
# EditorConfig: consistent formatting across editors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# C / C++ source and header files
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
tab_width = 4

# Makefiles require tabs for recipe commands
[Makefile]
indent_style = tab

[makefile]
indent_style = tab

[*.mk]
indent_style = tab

# JSON, YAML, TOML
[*.{json,yml,yaml,toml}]
indent_style = space
indent_size = 2

# Markdown: preserve intentional trailing spaces
[*.{md,markdown}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.{sh,bash}]
indent_style = space
indent_size = 4

# Python
[*.py]
indent_style = space
indent_size = 4
